# Copy to .env.local (Vercel: Project → Settings → Environment Variables)

# Canonical production URL — used for metadataBase, sitemap, OG and JSON-LD
NEXT_PUBLIC_SITE_URL=https://886taiwanyeshi.com.sg

# Delivery / online-ordering store link (GrabFood, foodpanda, Deliveroo…).
# Leave empty to hide the "Order delivery" buttons.
NEXT_PUBLIC_DELIVERY_URL=
NEXT_PUBLIC_DELIVERY_PARTNER=GrabFood

# Reservations: "walk-in" (default), or a booking URL (Chope, SevenRooms…) / "tel"
NEXT_PUBLIC_RESERVATIONS=walk-in

# Newsletter form action (Mailchimp / Klaviyo embed form URL). Empty = form hidden.
NEXT_PUBLIC_NEWSLETTER_ACTION=

# Google Tag Manager container (loads GA4 / Meta Pixel from there). Empty = no tracking.
NEXT_PUBLIC_GTM_ID=

# Google Search Console verification token (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
